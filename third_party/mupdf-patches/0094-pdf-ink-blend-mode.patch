Ink annotations honour PDF 2.0's /BM /Multiply in their synthesized appearance (H.3: the highlighter pen).
Base: patch 0093.

diff --git a/source/pdf/pdf-appearance.c b/source/pdf/pdf-appearance.c
index f164493..c646a8a 100644
--- a/source/pdf/pdf-appearance.c
+++ b/source/pdf/pdf-appearance.c
@@ -1062,8 +1062,10 @@ pdf_write_ink_appearance(fz_context *ctx, pdf_annot *annot, fz_buffer *buf, fz_r
 	float lw;
 	fz_point p;
 	int sc;
+	/* PDF 2.0's /BM on the annotation: a highlighter's ink multiplies, so the text under it stays as dark. */
+	int bm = pdf_name_eq(ctx, pdf_dict_get(ctx, annot->obj, PDF_NAME(BM)), PDF_NAME(Multiply)) ? FZ_BLEND_MULTIPLY : FZ_BLEND_NORMAL;
 
-	pdf_write_opacity(ctx, annot, buf, res);
+	pdf_write_opacity_blend_mode(ctx, annot, buf, res, bm);
 	pdf_write_dash_pattern(ctx, annot, buf, res);
 	lw = pdf_write_border_appearance(ctx, annot, buf);
 	sc = pdf_write_stroke_color_appearance(ctx, annot, buf);
