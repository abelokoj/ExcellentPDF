      "requires": ["%PDF-", "/ViewerPreferences", "/Direction /R2L", "%%EOF"],
      "check_qpdf": true,
      "check_pdftotext": true
    },
    {
      "id": "interop-acroform-fields",
      "file": "../corpus/acroform-fields.pdf",
      "requires": ["%PDF-", "/AcroForm", "/Subtype /Widget", "%%EOF"],
      "check_qpdf": true,
      "check_pdftotext": true
    },
    {
      "id": "interop-ten-page-paper",
      "file": "../corpus/ten-page-paper.pdf",
      "requires": ["%PDF-", "/PageLabels", "/Outlines", "%%EOF"],
      "check_qpdf": true,
      "check_pdftotext": true
    }
  ]
}
